{
  "name": "pingaura-ai",
  "displayName": "PingAura AI: Agentic Marketing",
  "description": "Agentic marketing from VS Code chat. Your agent finds what AI engines miss on your site, fixes it in your code, and tracks the result with PingAura AI.",
  "version": "0.1.0",
  "publisher": "pingaura",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "homepage": "https://www.pingaura.ai/docs/mcp/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingaura-ai/pingaura-vscode"
  },
  "bugs": {
    "url": "https://github.com/pingaura-ai/pingaura-vscode/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "agentic marketing",
    "ai marketing",
    "mcp",
    "aeo",
    "geo",
    "ai visibility",
    "answer engine optimization",
    "seo",
    "chatgpt",
    "copilot"
  ],
  "galleryBanner": {
    "color": "#0B0B0F",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "pingaura",
        "label": "PingAura AI"
      }
    ],
    "commands": [
      {
        "command": "pingaura.openDashboard",
        "title": "Open Dashboard",
        "category": "PingAura AI"
      },
      {
        "command": "pingaura.openDocs",
        "title": "Open MCP Docs",
        "category": "PingAura AI"
      },
      {
        "command": "pingaura.getStarted",
        "title": "Get Started",
        "category": "PingAura AI"
      }
    ],
    "configuration": {
      "title": "PingAura AI",
      "properties": {
        "pingaura.serverUrl": {
          "type": "string",
          "default": "https://www.pingaura.ai/api/mcp",
          "format": "uri",
          "markdownDescription": "PingAura MCP server URL. Only pingaura.ai hosts are accepted. Leave the default unless support asks you to change it.",
          "scope": "application"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with agentic marketing",
        "description": "Run your AI visibility work from VS Code chat.",
        "steps": [
          {
            "id": "account",
            "title": "Have a PingAura AI workspace",
            "description": "You need a workspace with a domain added.\n[Open PingAura AI](command:pingaura.openDashboard)",
            "media": {
              "markdown": "walkthrough/account.md"
            }
          },
          {
            "id": "signIn",
            "title": "Sign in",
            "description": "Ask a question in Chat (Agent mode). Approve the sign-in when your browser opens.\n[Open Chat](command:workbench.action.chat.open)",
            "media": {
              "markdown": "walkthrough/sign-in.md"
            }
          },
          {
            "id": "ask",
            "title": "Fix your site",
            "description": "Open your website's code and ask \"Fix the top site audit issues PingAura found.\" The agent edits the files and marks each issue fixed.\n[See all tools](command:pingaura.openDocs)",
            "media": {
              "markdown": "walkthrough/ask.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "ovsx": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.2",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
