{
  "name": "pingaura-ai",
  "displayName": "PingAura AI",
  "description": "Bring PingAura AI's AEO tools into VS Code chat: AI visibility, citations, site audits, prompts and content, through the PingAura MCP server.",
  "version": "0.1.0",
  "publisher": "pingaura",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "homepage": "https://www.pingaura.ai/docs/mcp/mcp-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingaura-ai/pingaura-vscode"
  },
  "bugs": {
    "url": "https://github.com/pingaura-ai/pingaura-vscode/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "mcp",
    "aeo",
    "geo",
    "ai visibility",
    "answer engine optimization",
    "seo",
    "chatgpt",
    "copilot"
  ],
  "galleryBanner": {
    "color": "#0B0B0F",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "pingaura",
        "label": "PingAura AI"
      }
    ],
    "commands": [
      {
        "command": "pingaura.openDashboard",
        "title": "Open Dashboard",
        "category": "PingAura AI"
      },
      {
        "command": "pingaura.openDocs",
        "title": "Open MCP Docs",
        "category": "PingAura AI"
      },
      {
        "command": "pingaura.getStarted",
        "title": "Get Started",
        "category": "PingAura AI"
      }
    ],
    "configuration": {
      "title": "PingAura AI",
      "properties": {
        "pingaura.serverUrl": {
          "type": "string",
          "default": "https://www.pingaura.ai/api/mcp",
          "format": "uri",
          "markdownDescription": "PingAura MCP server URL. Leave the default unless PingAura support gives you another one."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get started with PingAura AI",
        "description": "Use PingAura AI's AEO tools from VS Code chat.",
        "steps": [
          {
            "id": "account",
            "title": "Have a PingAura AI account",
            "description": "You need a PingAura AI workspace with a domain added.\n[Open PingAura AI](command:pingaura.openDashboard)",
            "media": {
              "markdown": "walkthrough/account.md"
            }
          },
          {
            "id": "signIn",
            "title": "Sign in once",
            "description": "Open Chat in Agent mode and ask about your AI visibility. The first time, VS Code opens the PingAura AI sign-in in your browser. Approve it, and you are connected.\n[Open Chat](command:workbench.action.chat.open)",
            "media": {
              "markdown": "walkthrough/sign-in.md"
            }
          },
          {
            "id": "ask",
            "title": "Ask in plain language",
            "description": "Try: \"What is my AI visibility score this week?\" or \"Which site audit issues should I fix first?\"\n[See all tools](command:pingaura.openDocs)",
            "media": {
              "markdown": "walkthrough/ask.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "ovsx": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.33.2"
}
